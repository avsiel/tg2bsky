# Telegram → Bluesky auto-publisher
#
# Secrets are loaded from environment / .env file. Never commit .env.
#
# Copy this file to `.env` and fill in real values.

# --- Telegram ---
# Bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Chat ID of the source Telegram channel (e.g. -1001234567890).
# The bot must be added as an administrator of this channel.
TELEGRAM_SOURCE_CHAT_ID=

# --- Bluesky ---
# Account handle, e.g. user.bsky.social
BSKY_HANDLE=
# App password (Settings -> App passwords), NOT the account password
BSKY_APP_PASSWORD=

# --- Admin / management ---
# Telegram user IDs allowed to run management commands (/status, /queue, ...)
# Comma-separated, e.g. 123456789,987654321
ADMIN_USER_IDS=

# --- Behaviour ---
# Where the SQLite database lives
DB_PATH=app.db
# Long-polling timeout (seconds)
TG_POLL_TIMEOUT=30
# Max retries for a failed publish before marking it "failed"
MAX_RETRIES=5
# Delay (seconds) between retry attempts
RETRY_BASE_DELAY=60
